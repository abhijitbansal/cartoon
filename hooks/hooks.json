{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "command -v cartoon >/dev/null 2>&1 && cartoon hook rewrite || exit 0",
            "timeout": 10,
            "statusMessage": "cartoon: checking for auto-wrap"
          }
        ]
      }
    ]
  }
}
